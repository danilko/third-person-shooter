#
# https://help.github.com/articles/dealing-with-line-endings/
#
# These are explicitly windows files and should use crlf
*.bat           text eol=crlf

# Git LFS — large binary 3D formats, everywhere in the repo (never meaningfully diffable as text).
*.glb filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text

# Git LFS — baked/generated world content only (districts + master world layout). Scoped rather
# than repo-wide for .tscn/.json/.gltf/.bin so small hand-authored scenes (character/weapon/UI)
# keep normal git diffing; these are machine-generated per bake and never hand-edited anyway.
# (*.blend1 is gitignored entirely — never committed, no LFS rule needed for it.)
assets/world_source/plateau/data/*.json filter=lfs diff=lfs merge=lfs -text
src/main/resources/com/openworld/world/pieces/*.gltf filter=lfs diff=lfs merge=lfs -text
src/main/resources/com/openworld/world/pieces/*.bin filter=lfs diff=lfs merge=lfs -text
src/main/resources/com/openworld/world/pieces/*.tscn filter=lfs diff=lfs merge=lfs -text
# .scn = binary resave of the district .tscn (DistrictBinaryConverter — faster stream-in parse).
# Derived + regenerable, but LFS-committed so a fresh checkout streams fast without a converter run.
src/main/resources/com/openworld/world/pieces/*.scn filter=lfs diff=lfs merge=lfs -text
src/main/resources/com/openworld/world/master/*.gltf filter=lfs diff=lfs merge=lfs -text
src/main/resources/com/openworld/world/master/*.bin filter=lfs diff=lfs merge=lfs -text
src/main/resources/com/openworld/world/master/*.tscn filter=lfs diff=lfs merge=lfs -text
