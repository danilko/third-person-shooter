#
# https://help.github.com/articles/dealing-with-line-endings/
#
# These are explicitly windows files and should use crlf
*.bat           text eol=crlf

# Git LFS — large binary 3D formats, everywhere in the repo (never meaningfully diffable as text).
*.glb filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text

# Git LFS — baked/generated world content only (districts + master world layout). Scoped rather
# than repo-wide for .tscn/.json/.gltf/.bin so small hand-authored scenes (character/weapon/UI)
# keep normal git diffing; these are machine-generated per bake and never hand-edited anyway.
# (*.blend1 is gitignored entirely — never committed, no LFS rule needed for it.)
assets/world_source/plateau/data/*.json filter=lfs diff=lfs merge=lfs -text
src/main/resources/com/openworld/world/pieces/*.gltf filter=lfs diff=lfs merge=lfs -text
src/main/resources/com/openworld/world/pieces/*.bin filter=lfs diff=lfs merge=lfs -text
src/main/resources/com/openworld/world/pieces/*.tscn filter=lfs diff=lfs merge=lfs -text
# .scn = binary resave of the district .tscn (DistrictBinaryConverter — faster stream-in parse).
# Derived + regenerable, but LFS-committed so a fresh checkout streams fast without a converter run.
src/main/resources/com/openworld/world/pieces/*.scn filter=lfs diff=lfs merge=lfs -text
src/main/resources/com/openworld/world/master/*.gltf filter=lfs diff=lfs merge=lfs -text
src/main/resources/com/openworld/world/master/*.bin filter=lfs diff=lfs merge=lfs -text
src/main/resources/com/openworld/world/master/*.tscn filter=lfs diff=lfs merge=lfs -text

# Git LFS — third-party addon binaries. `addons/` is TRACKED (not ignored): the project cannot be
# opened without addons/jvm (the godot-jvm 1.0 GDExtension), terrain_3d, road-generator and
# sky_3d, so a fresh clone that lacks them is not a checkout of this project. The native
# libraries are ~90% of the bulk and none of it is diffable.
*.so filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
*.aar filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
# A macOS framework's binary carries NO extension (terrain_3d/bin/libterrain.macos.debug.framework/
# libterrain.macos.debug, jvm/libs/macos/godot.jvm.macos.editor.framework/godot.jvm.macos.editor),
# so the suffix rules above cannot reach it — match the bundle instead. Both addons ship one.
addons/**/*.framework/** filter=lfs diff=lfs merge=lfs -text
# Addon art. Scoped to addons/ so hand-authored project textures keep ordinary git behaviour.
addons/**/*.png filter=lfs diff=lfs merge=lfs -text
addons/**/*.jpg filter=lfs diff=lfs merge=lfs -text
addons/**/*.exr filter=lfs diff=lfs merge=lfs -text

# Git LFS — Terrain3D region data. This is the AUTHORED terrain from here on (sculpted in the
# editor, no other copy exists), and every sculpt rewrites the region it touched.
assets/terrain3d/**/*.res filter=lfs diff=lfs merge=lfs -text

# Git LFS — Terrain3D surface textures (channel-packed albedo+height / normal+roughness, ~12 MB).
assets/terrain3d/textures/*.png filter=lfs diff=lfs merge=lfs -text
